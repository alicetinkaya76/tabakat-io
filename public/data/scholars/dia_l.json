": 30.0444, "lng": 31.2357, "primary_place_modern": "Kahire", "relations_count": 40, "works_count": 22, "genres": ["Tabakât (Biyografi)", "Terâcim (Biyografi)"], "tabakat_books": 3, "field_normalized": "hadith", "madhab_normalized": "Mâlikî", "era_normalized": "Abbasid", "book_list": ["0911Suyuti.TabaqatHuffaz", "0354IbnHibbanBusti.MashahirCulamaAmsar", "0578IbnBashkuwal.ShuyukhIbnWahb"], "alam_id": 8694, "alam_text_len": 482, "tabakat_cluster_id": 550, "places": [{"name": "القاهرة", "modern": "Kahire", "lat": 30.0444, "lng": 31.2357, "region": "Mısır", "role": "origin"}, {"name": "خراسان", "modern": "Horasan", "lat": 35.0, "lng": 59.0, "region": "İran", "role": "origin"}], "primary_place": "القاهرة", "primary_region": "Mısır", "narrative_en": "Al-Layth b. Sa'd (713–791 CE) was a prominent Abbasid-era hadith scholar and jurist based in Egypt, renowned for his mastery of hadith criticism and jurisprudence. He became one of the most respected muhaddithūn of his generation, known for his rigorous methodology in evaluating hadith transmissions and his independent legal reasoning (ijtihād). Al-Layth studied under multiple prominent scholars and developed a jurisprudential approach that influenced Egyptian legal tradition, though later juridical developments favored the Mālikī school. His extensive collection of hadith transmissions and his critical acumen established him as a mutlak mujtahid whose influence extended throughout the Islamic world.", "narrative_tr": "El-Leyth b. Sa'd (713–791 CE), Abbasi döneminin Mısır'da yaşamış ve hadis tenkidi ile fıkıh alanında temayüz etmiş ünlü muhaddis ve fâkihiydi. Nesli içerisinde en saygın hadis âlimleri arasında yer alan el-Leyth, hadis rivayetlerini değerlendirmede titiz bir metodoloji ve bağımsız hukuki muhakeme (içtihâd) ile tanınıyordu. Sayısız seçkin âlimin talebi olup, Mısır hukuk geleneğini şekillendiren bir fıkhi yaklaşım geliştirdi; ancak sonraki dönemlerde Mālikī mezhebinin hukuki gelişimleri ağır bastı. Geniş hadis koleksiyonları ve eleştirel becerileri, mutlak mujtehid olarak tüm İslam dünyasında etkili olmasını sağladı.", "narrative_ar": "الليث بن سعد (713–791 م) كان من أبرز علماء الحديث والفقهاء في العصر العباسي، اشتهر بنقد الحديث والاجتهاد الفقهي. درس على عدد من العلماء البارزين وطور منهجاً دقيقاً في تقييم الروايات الحديثية والاستنباط الفقهي المستقل. كان من أعظم المحدثين في جيله وترك أثراً عميقاً في التقليد الحديثي والفقهي المصري، رغم أن المذهب المالكي استقطب الانتباه الأكبر في الأجيال اللاحقة. يعتبر الليث من المجتهدين المطلقين الذين أثروا على الساحة الإسلامية برمتها.", "silsile_chain_en": "Ibn Wahb (d. 813) → al-Layth b. Sa'd (d. 791) → ʿAmr b. al-Ḥārith (d. 765) and Yahyā b. Saʿīd (d. 760) → Egyptian hadith tradition", "silsile_chain_tr": "İbn Vehb (ö. 813) → El-Leyth b. Sa'd (ö. 791) → ʿAmr b. el-Hāris (ö. 765) ve Yahyā b. Saʿīd (ö. 760) → Mısır hadis geleneği", "silsile_chain_ar": "ابن وهب (ت. 813) ← الليث بن سعد (ت. 791) ← عمرو بن الحارث (ت. 765) ويحيى بن سعيد (ت. 760) ← التقليد الحديثي المصري", "education_cities": [{"city_en": "Egypt", "city_tr": "Mısır", "lat": 26.82, "lon": 30.8}, {"city_en": "Mecca", "city_tr": "Mekke", "lat": 21.43, "lon": 39.83}]}, "dia:leysi": {"id": "dia:leysi", "name_ar": "الليثي", "name_tr": "LEYSÎ", "name_en": "al-Laythī", "death_ce": 1074, "death_h": 466, "nisbe": "Leysî; Buhârî", "kunya": "أبو القاسم", "gender": "M", "field": "Qurʾān Reader", "sub_fields": ["hadith"], "madhab": "Hanefî", "era": "Seljuk", "bio": "Hadis hâfızı.", "death_place": "Hûzistan", "importance": "medium", "sources": ["alam", "dia", "tabakat"], "source_count": 3, "dia_slug": "leysi", "dia_importance": 34.34, "lat": 39.6542, "lng": 66.9597, "primary_place_modern": "Semerkand", "relations_count": 10, "works_count": 8, "genres": ["Ensâb (Soy/Nisbe/Kabile)", "Tehzîb (Ricâl Özeti)"], "tabakat_books": 2, "field_normalized": "general", "madhab_normalized": "Hanefî", "era_normalized": "Seljuk", "book_list": ["0562Samcani.Ansab", "0630IbnAthirCizzDin.LubabFiTahdhibAnsab"], "ala